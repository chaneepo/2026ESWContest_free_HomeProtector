# Docker PostgreSQL development settings
POSTGRES_DB=care_pack
POSTGRES_USER=care_pack
POSTGRES_PASSWORD=care_pack_dev_password
POSTGRES_PORT=5432

# Used by the future FastAPI/SQLAlchemy backend running on the host.
DATABASE_URL=postgresql+psycopg://care_pack:care_pack_dev_password@localhost:5432/care_pack
TEST_DATABASE_URL=postgresql+psycopg://care_pack:care_pack_dev_password@localhost:5432/care_pack_test

# Set to a verified endpoint on a trusted LAN or SSH tunnel; no fallback.
# Example SSH tunnel: http://127.0.0.1:8090
RASPBOT_API_URL=
CAMERA_API_URL=
